# Copy to .env in this folder (gitignored) and fill in. Values are read at build time via
# react-native-dotenv and consumed in src/config.ts. Keys are IOS_-prefixed so they
# never collide with the Android app.

# Splunk RUM access token (O11y → Settings → Access Tokens, RUM authorization).
IOS_SPLUNK_RUM_ACCESS_TOKEN=

# AppDynamics mobile (EUM) app key — only needed if rum.provider = 'appdynamics'.
IOS_APPDYNAMICS_APP_KEY=
