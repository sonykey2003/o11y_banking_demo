# Copy to .env in this folder (gitignored) and fill in. Values are read at build time via
# react-native-dotenv and consumed in src/config.ts. Keys are IOS_-prefixed so they
# never collide with the Android app.

# Splunk RUM access token (O11y → Settings → Access Tokens, RUM authorization).
IOS_SPLUNK_RUM_ACCESS_TOKEN=

# Identity shown in O11y. Change these when sharing an O11y instance so your data
# does not collide with someone else's. Defaults are used when left blank.
IOS_SPLUNK_REALM=us1
IOS_RUM_APP_NAME=demoBanking-rum-ios
IOS_RUM_ENVIRONMENT=demoBanking-rum

# Session replay (needs an Enterprise subscription): share of sessions recorded, 0..1.
# Blank means 1 (every session). Set 0 to turn replay off.
IOS_SESSION_REPLAY_SAMPLE_RATE=

# AppDynamics mobile (EUM) app key — only needed if rum.provider = 'appdynamics'.
IOS_APPDYNAMICS_APP_KEY=
