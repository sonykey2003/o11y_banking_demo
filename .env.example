# SEA Bank demo — configuration for the backend / instrumentation scripts.
#
# Copy to .env (gitignored) and fill in:   cp .env.example .env
#
# Mobile RUM tokens are SEPARATE — see app-ios/.env and app-android/.env, which are
# read by react-native-dotenv at build time.
#
# Secrets may be raw values or 1Password refs (op://vault/item/field).

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Splunk Observability Cloud
# ─────────────────────────────────────────────────────────────────────────────
# Your realm, e.g. us0 | us1 | eu0 | jp0 | au0. Find it in O11y under your profile.
export SPLUNK_REALM="us1"
# O11y > Settings > Access Tokens. Needs ingest scope.
export SPLUNK_ACCESS_TOKEN=""

# Helm release name for the Splunk OTel Collector.
export HELM_RELEASE="splunk-otel-collector"

# ─────────────────────────────────────────────────────────────────────────────
# Cluster / collector placement
# ─────────────────────────────────────────────────────────────────────────────
export DEMO_CLUSTER_NAME="sea-bank-demo"
export DEMO_ENVIRONMENT="demoBanking-rum"       # deployment.environment tag
export DEMO_APP_NAMESPACE="sea-bank-demo"       # where the Node services run
export DEMO_OTEL_NAMESPACE="splunk-otel"        # collector + operator in their OWN namespace

# ─────────────────────────────────────────────────────────────────────────────
# Feature toggles
# ─────────────────────────────────────────────────────────────────────────────
export DEMO_PROFILING_ENABLED="false"
export DEMO_DISCOVERY_ENABLED="true"

# High-res (1s) application metrics (optional). Comma-separated metric name(s) to store at 1s
# in O11y (e.g. "auth_login_total,account_balance_requests_total"). Empty = off. When set, the
# Node SDK metric export interval drops to DEMO_HIRES_EXPORT_INTERVAL_MS (default 1000ms) and
# each metric is tagged sf_hires=1. Restart the app pods after `connect` so the interval injects.
export DEMO_HIRES_METRIC=""
# export DEMO_HIRES_EXPORT_INTERVAL_MS="1000"

# Pin the Splunk OTel Collector chart version (default 0.157.0). Newer charts (0.158+) dropped
# the top-level `certmanager` key and break `helm upgrade`. Set empty to track latest.
# export DEMO_HELM_CHART_VERSION="0.157.0"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — trace-correlated logs via Log Observer Connect (scripts/splunk-logs.sh)
# Only needed if you want the APM "Related Logs" tab. Requires a Splunk Cloud stack.
# ─────────────────────────────────────────────────────────────────────────────
export DEMO_SPLUNK_STACK=""                     # bare stack name, no domain suffix
export DEMO_SPLUNK_ACS_URL="https://admin.splunk.com"
export DEMO_SPLUNK_INDEX="sea_bank_demo"
export DEMO_SPLUNK_INDEX_SEARCHABLE_DAYS="90"
export DEMO_SPLUNK_INDEX_MAX_SIZE_MB="0"        # 0 = use stack default / DDAA
# Override only for Splunk Enterprise / a custom HEC host; otherwise derived from the stack.
# export DEMO_SPLUNK_HEC_URL=""

# HEC token the collector writes app logs with (Splunk Cloud > Settings > Data Inputs > HEC).
export SPLUNK_CLOUD_HEC=""

# Splunk Cloud admin used ONCE to mint an ACS token; the password is prompted, never stored.
export SPLUNK_USERNAME="admin"
export SPLUNK_TOKEN_AUDIENCE="o11y-log-observer-connect"
export SPLUNK_TOKEN_EXPIRES_ON="+90d"

# Service account O11y authenticates as to read the index.
export SPLUNK_LOC_SERVICE_ACCOUNT=""
export SPLUNK_LOC_SERVICE_PASSWORD=""
export SPLUNK_LOC_ROLE="o11y_loc_role"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Database Monitoring (scripts/splunk-dbmon.sh)
# ─────────────────────────────────────────────────────────────────────────────
export DEMO_DBMON_DB_PASSWORD=""                # defaults to a demo value if blank
